@inproceedings{jeong2026mvsam,
  title={MV-SAM: Multi-view Promptable Segmentation using Pointmap Guidance},
  author={Yoonwoo Jeong and Cheng Sun and Yu-Chiang Frank Wang and Minsu Cho and Jaesung Choe},
  abstract={Promptable segmentation has emerged as a powerful paradigm in computer vision, enabling users to guide models in parsing complex scenes with prompts such as clicks, boxes, or textual cues. Recent advances, exemplified by the Segment Anything Model (SAM), have extended this paradigm to videos and multi-view images. However, the lack of 3D awareness often leads to inconsistent results, necessitating costly per-scene optimization to enforce 3D consistency. In this work, we introduce MV-SAM, a framework for multi-view segmentation that achieves 3D consistency using pointmaps--3D points reconstructed from unposed images by recent visual geometry models. Leveraging the pixel–point one-to-one correspondence of pointmaps, MV-SAM lifts images and prompts into 3D space, eliminating the need for explicit 3D networks or annotated 3D data. Specifically, MV-SAM extends SAM by lifting image embeddings from its pretrained encoder into 3D point embeddings, which are decoded by a transformer using cross-attention with 3D prompt embeddings. This design aligns 2D interactions with 3D geometry, enabling the model to implicitly learn consistent masks across views through 3D positional embeddings. Trained on the SA-1B dataset, our method generalizes well across domains, outperforming SAM2-Video and achieving comparable performance with per-scene optimization baselines on NVOS, SPIn-NeRF, ScanNet++, uCo3D, and DL3DV benchmarks. Code will be released.},
  booktitle=NVIDIA,
  year={2026},
  arxiv={2601.17866},
  selected={true},
  abbr={NVIDIA tech report},
  website={https://jaesung-choe.github.io/mv_sam},
  img_path={assets/img/publication_preview/nvidia_2026_mvsam.png},
  category={understanding},
  topics={Segmentation, 3D Understanding},
  role={First author},
  accent={#e07a2e},
  react={mvsam},
  say={Segment me!},
  hook={Click one object in one photo — get it segmented consistently in every view.},
  problem={SAM-style segmenters lack 3D awareness, so masks drift between views of the same scene unless you run costly per-scene optimization.},
  idea={MV-SAM lifts SAM image embeddings and your prompts into 3D with pointmaps reconstructed from unposed images, so a transformer decodes masks that agree across views. No 3D network or 3D labels: it trains on SA-1B alone.},
  result={Outperforms SAM2-Video and matches per-scene optimization baselines on NVOS, SPIn-NeRF, ScanNet++, uCo3D and DL3DV.},
  my_role={First author: an extension of SAM to multi-view inputs, trained without 3D or video datasets.}
}

@inproceedings{jeong2025quantile,
  title={Quantile Rendering: Efficiently Embedding High-dimensional Features on 3D Gaussian Splatting},
  author={Yoonwoo Jeong and Cheng Sun and Yu-Chiang Frank Wang and Minsu Cho and Jaesung Choe},
  abstract={We present Quantile Rendering (Q-Render), an efficient rendering algorithm for 3D Gaussians that involve high-dimensional feature vectors. Unlike conventional volume rendering, which densely samples all 3D Gaussians intersecting each ray, Q-Render sparsely samples 3D Gaussians that have dominant influence along ray. The dominance is determined by transmittance change analysis, and the only sampled Gaussians will participate in subsequent rendering steps such as alpha blending. In our framework, Q-Render is integrated with a conventional 3D neural network that operates on 3D Gaussians, named Gaussian Splatting Network (GS-Net), to predict Gaussian features. We evaluate GS-Net on open-vocabulary 3D semantic segmentation using two benchmarks: (1) ScanNet and (2) LeRF-OVS, where 3D Gaussians are enriched with CLIP-based language features. Extensive experiments show that Q-Render under GS-Net consistently outperforms existing methods, achieving superior results and highlighting its potential as an effective bridge between 2D foundation models and 3D Gaussian representations. Furthermore, our Q-render achieves ~43.7× speed gains against previous methods when rendering 512-D feature maps.},
  booktitle=NVIDIA,
  year={2025},
  arxiv={2512.20927},
  selected={true},
  abbr={NVIDIA tech report},
  website={https://jaesung-choe.github.io/qrender},
  img_path={assets/img/publication_preview/nvidia_2025_qrender.png},
  category={gaussians},
  topics={Gaussian Splatting, Segmentation, 3D Understanding},
  role={First author},
  accent={#7b5cc4},
  react={qrender},
  say={43.7× faster!},
  hook={Render 512-D feature maps from 3D Gaussians {\textasciitilde}44× faster by sampling only the Gaussians that matter.},
  problem={Attaching high-dimensional features such as CLIP embeddings to 3D Gaussians makes rendering slow, because every Gaussian along each ray is blended, so prior work compresses the features.},
  idea={Q-Render samples only the Gaussians with dominant influence along each ray, found by analyzing transmittance changes. A Gaussian Splatting Network (GS-Net) predicts the features, so it generalizes across scenes.},
  result={State-of-the-art open-vocabulary 3D segmentation on ScanNet and LeRF-OVS, with real-time rendering of full 512-D features.},
  result_num={43.7×},
  result_label={faster 512-D feature rendering},
  my_role={First author: a generalizable 3D-GS network for open-vocabulary segmentation.}
}



@inproceedings{jeong2024rodygs,
  title={RoDyGS: Robust Dynamic Gaussian Splatting for Casual Videos},
  author={Junmyeong Lee and Hoseung Choi and Yoonwoo Jeong and Minsu Cho},
  abstract={Dynamic view synthesis (DVS) has advanced remarkably in recent years, achieving high-fidelity rendering while reducing computational costs. Despite the progress, optimizing dynamic neural fields from casual videos remains challenging, as these videos do not provide direct 3D information, such as camera trajectories or the underlying scene geometry. In this work, we present RoDyGS, an optimization pipeline for dynamic Gaussian Splatting from casual videos. It effectively learns motion and underlying geometry of scenes by separating dynamic and static primitives, and ensures that the learned motion and geometry are physically plausible by incorporating motion and geometric regularization terms. We also introduce a comprehensive benchmark, Kubric-MRig, that provides extensive camera and object motion along with simultaneous multi-view captures, features that are absent in previous benchmarks. Experimental results demonstrate that the proposed method significantly outperforms previous pose-free dynamic neural fields and achieves competitive rendering quality compared to existing pose-free static neural fields.},
  booktitle=arXiv,
  year={2025},
  arxiv={2412.03077},
  selected={true},
  abbr={arXiv},
  website={https://rodygs.github.io/},
  code={https://github.com/POSTECH-CVLab/RoDyGS},
  img_path={assets/img/publication_preview/arxiv_2024_rodygs.png},
  category={gaussians},
  topics={Gaussian Splatting, Neural Fields},
  role={Third author},
  accent={#2f8fc9},
  react={rodygs},
  say={Hold the camera still!},
  hook={Rebuild moving scenes in 3D from a casual phone video — no camera poses needed.},
  problem={Casual videos come without camera poses or scene geometry, which makes optimizing dynamic 3D scenes from them fragile.},
  idea={RoDyGS separates static and dynamic Gaussians and adds motion and geometry regularizers so the learned motion stays physically plausible. It also introduces Kubric-MRig, a benchmark with rich camera and object motion plus multi-view captures.},
  result={Significantly outperforms previous pose-free dynamic neural fields and is competitive with pose-free static methods in rendering quality.},
  my_role={Third author on this pose-free dynamic neural field pipeline that leverages geometric foundation models.}
}

@inproceedings{jeong2024nvsadapter,
  title={NVS-Adapter: Plug-and-Play Novel View Synthesis from a Single Image},
  author={Yoonwoo Jeong and Jinwoo Lee and Chiheon Kim and Minsu Cho and Doyup Lee},
  abstract={Transfer learning of large-scale Text-to-Image (T2I) models has recently shown impressive potential for Novel View Synthesis (NVS) of diverse objects from a single image. While previous methods typically train large models on multi-view datasets for NVS, fine-tuning the whole parameters of T2I models not only demands a high cost but also reduces the generalization capacity of T2I models in generating diverse images in a new domain. In this study, we propose an effective method, dubbed NVS-Adapter, which is a plug-and-play module for a T2I model, to synthesize novel multi-views of visual objects while fully exploiting the generalization capacity of T2I models. NVS-Adapter consists of two main components; view-consistency cross-attention learns the visual correspondences to align the local details of view features, and global semantic conditioning aligns the semantic structure of generated views with the reference view. Experimental results demonstrate that the NVS-Adapter can effectively synthesize geometrically consistent multi-views and also achieve high performance on benchmarks without full fine-tuning of T2I models. The code and data are publicly available in \href{https://postech-cvlab.github.io/nvsadapter/}{https://postech-cvlab.github.io/nvsadapter/}.},
  booktitle=ECCV,
  year={2024},
  abbr={ECCV},
  selected={true},
  arxiv={2312.07315},
  website={https://postech-cvlab.github.io/nvsadapter/},
  code={https://github.com/POSTECH-CVLab/nvsadapter}, 
  img_path={assets/img/publication_preview/eccv_2024_nvsadapter.png},
  category={multimodal},
  topics={Generation, Neural Fields},
  role={First author},
  accent={#b8962a},
  react={nvsadapter},
  say={Let me see the other side!},
  equal_contrib_authors={Yoonwoo Jeong, Jinwoo Lee},
  hook={Turns a text-to-image model into a novel-view generator with a small plug-in, without full fine-tuning.},
  problem={Novel view synthesis from one image usually fine-tunes a whole text-to-image model, which is expensive and erodes its ability to generate diverse images.},
  idea={A plug-and-play adapter: view-consistency cross-attention aligns local details across views, and global semantic conditioning keeps generated views faithful to the reference image.},
  result={Synthesizes geometrically consistent multi-views with strong benchmark results without full fine-tuning, and works with ControlNet and LoRA out of the box.},
  my_role={First author (equal contribution): a parameter-efficient adapter for text-to-3D generative models.}
}

@inproceedings{kim2023choir,
  title={Stable and Consistent Prediction of 3D Characteristic Orientation via Invariant Residual Learning},
  author={Seungwook Kim and Chunghyun Park and Yoonwoo Jeong and Jaesik Park and Minsu Cho},
  abstract={Learning to predict reliable characteristic orientations of 3D point clouds is an important yet challenging problem, as different point clouds of the same class may have largely varying appearances. In this work, we introduce a novel method to decouple the shape geometry and semantics of the input point cloud to achieve both stability and consistency. The proposed method integrates shape-geometry-based SO(3)-equivariant learning and shape-semantics-based SO(3)-invariant residual learning, where a final characteristic orientation is obtained by calibrating an SO(3)-equivariant orientation hypothesis using an SO(3)-invariant residual rotation. In experiments, the proposed method not only demonstrates superior stability and consistency but also exhibits state-of-the-art performances when applied to point cloud part segmentation, given randomly rotated inputs.},
  booktitle=ICML,
  year={2023},
  abbr={ICML},
  arxiv={2306.11406},
  selected={false},
  code={https://github.com/POSTECH-CVLab/CHOIR},
  img_path={assets/img/publication_preview/icml_2023_choir.png},
  category={point-clouds},
  topics={Point Cloud, Segmentation},
  role={Third author},
  accent={#b3548a},
  anim={choir},
  react={choir},
  say={Canonical pose!},
  hook={Finds the upright, facing-forward pose of a 3D shape: stable for each object and consistent across a class.},
  problem={Predicting a reliable characteristic orientation for 3D point clouds is hard: shapes of the same class can look very different, and predictions jump around under rotation.},
  idea={Decouple geometry and semantics: an SO(3)-equivariant network proposes an orientation from shape geometry, and an SO(3)-invariant residual rotation learned from semantics corrects it.},
  result={Superior stability and consistency, and state-of-the-art part segmentation on randomly rotated point clouds.},
  my_role={Third author: a 3D canonicalization framework for robust part-level segmentation.}
}

@inproceedings{kim2022selca,
  title={SeLCA: Self-Supervised Learning of Canonical Axes},
  author={Seungwook Kim and Yoonwoo Jeong and Chunghyun Park and Jaesik Park and Minsu Cho},
  abstract={Robustness to rotation is critical for point cloud understanding tasks as point cloud features can be affected dramatically with respect to prevalent rotation changes. In this work, we introduce a novel self-supervised learning framework, dubbed SeLCA, that predicts a canonical axis of point clouds in a probabilistic manner. In essence, we propose to learn rotational-equivariance by predicting the canonical axis of point clouds, and achieve rotational-invariance by aligning the point clouds using their predicted canonical axis. When integrated into a rotation-sensitive pipeline, SeLCA achieves competitive performances on the ModelNet40 classification task under unseen rotations. Our proposed method also shows high robustness to various real-world point cloud corruptions presented by the ModelNet40-C dataset, compared to the state-of-the-art rotation-invariant method.},
  booktitle=NeurIPS-W,
  year={2022},
  abbr={NeurIPS-W},
  selected={false},
  website={https://openreview.net/forum?id=Lwp_CgpFuA0},
  img_path={assets/img/publication_preview/neurips_w_2022_selca.png},
  category={point-clouds},
  topics={Point Cloud},
  role={Second author},
  accent={#a8322f},
  anim={selca},
  react={selca},
  say={Which way is up?},
  hook={Teaches a network to find a point cloud's canonical axis on its own, making 3D recognition robust to rotation.},
  problem={Point cloud features change dramatically when objects rotate, which hurts recognition.},
  idea={Self-supervised: predict a probabilistic canonical axis (rotation-equivariant), then align the point cloud to it, giving rotation-invariant input to any downstream network.},
  result={Competitive ModelNet40 classification under unseen rotations, and high robustness to real-world corruptions in ModelNet40-C.},
  my_role={Second author on this self-supervised canonicalization framework.}
}


